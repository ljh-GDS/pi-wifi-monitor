# Pi WiFi Monitor - Environment Configuration
# Copy this file to .env and update the values

# ===========================================
# GRAFANA CONFIGURATION
# ===========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# ===========================================
# TELEGRAM ALERTING (Required for alerts)
# ===========================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID by messaging @userinfobot or @get_id_bot
TELEGRAM_CHAT_ID=your_chat_id_here

# ===========================================
# SPEEDTEST CONFIGURATION
# ===========================================
# Interval between speed tests in seconds (default: 300 = 5 minutes)
SPEEDTEST_INTERVAL=300

# ===========================================
# PING CONFIGURATION
# ===========================================
# Comma-separated list of targets to ping
PING_TARGETS=8.8.8.8,1.1.1.1,208.67.222.222

# Interval between ping cycles in seconds (default: 10)
PING_INTERVAL=10

# ===========================================
# NETWORK SCANNER CONFIGURATION
# ===========================================
# Network range to scan (CIDR notation)
# Common home network ranges:
#   - 192.168.1.0/24
#   - 192.168.0.0/24
#   - 10.0.0.0/24
NETWORK_RANGE=192.168.1.0/24

# Interval between network scans in seconds (default: 300 = 5 minutes)
SCAN_INTERVAL=300
